# ===========================================
# Healthcare Appointment System - Environment
# Copy this file to .env and fill in real values.
# Never commit your real .env file.
# ===========================================

# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Database (SQLite file path, relative to project root)
DB_PATH=./data/healthcare.db

# Twilio (SMS reminders)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# If true, SMS sends are logged instead of actually sent (safe for local dev)
SMS_DRY_RUN=true

# Reminder lead time, in minutes, before an appointment to send the SMS
REMINDER_LEAD_MINUTES=60

# Audit log retention (days) - simulates HIPAA-style access log policies
AUDIT_LOG_RETENTION_DAYS=2190
